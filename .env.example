# Copy this file to `.env` and adjust the values for your machine.
# `.env` is gitignored, so your real secrets are never committed.

# A long, random string. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=django-insecure-dev-only-change-me

# True while developing (shows detailed error pages). Set to False in production.
DEBUG=True

# Comma-separated list of hosts Django is allowed to serve.
ALLOWED_HOSTS=127.0.0.1,localhost
